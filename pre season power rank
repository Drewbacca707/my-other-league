    .author-info {
      font-size: 0.85rem;
      line-height: 1.3;
    }

    .author-name {
      font-weight: 700;
      color: var(--br-black);
    }

    .date {
      color: var(--br-gray);
    }

    /* Intro / Standfirst */
    .lead-paragraph {
      font-size: 1.15rem;
