    .predictions-list li::before {
      content: "•";
      color: #ff3e3e;
      font-size: 1.5rem;
      position: absolute;
      left: 0;
      top: -4px;
    }

    .awards-list li {
      display: flex;
      justify-content: space-between;
      border-bottom: 1px solid #2d2d2d;
      padding: 0.6rem 0;
