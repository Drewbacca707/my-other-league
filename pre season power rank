      font-size: 1rem;
      color: #333;
      margin-bottom: 0.75rem;
    }

    .verdict {
      font-weight: 700;
      font-size: 0.95rem;
      color: #111;
      margin-top: 0.5rem;
    }

    blockquote.pullquote {
      margin: 1rem 0;
      padding: 0.75rem 1.25rem;
