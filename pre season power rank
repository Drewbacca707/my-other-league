      font-family: var(--font-headline);
      font-size: 2rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 1.25rem;
      border-bottom: 2px solid #333;
      padding-bottom: 0.5rem;
    }

    .predictions-list, .awards-list {
      list-style: none;
    }

    .predictions-list li {
      position: relative;
      padding-left: 1.5rem;
      margin-bottom: 0.85rem;
      font-size: 1rem;
      line-height: 1.4;
